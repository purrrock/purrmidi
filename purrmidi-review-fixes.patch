diff --git a/Engine/midi/midi_queue.c b/Engine/midi/midi_queue.c
index c5d5a5c..3e2a2e2 100644
--- a/Engine/midi/midi_queue.c
+++ b/Engine/midi/midi_queue.c
@@ -15,6 +15,22 @@ static volatile uint32_t head = 0;
 static volatile uint32_t tail = 0;
 static volatile uint32_t overrun_count = 0;
 
+/*
+ * SPSC-очередь: данные в queue_buffer[] пишутся ОБЫЧНЫМИ (не volatile) обращениями, а индексы
+ * head/tail — volatile. volatile не является барьером для обычной памяти: компилятор вправе
+ * переставить запись элемента после публикации head (и наоборот при чтении). Поэтому публикация
+ * индекса идёт с release-семантикой, а чтение чужого индекса — с acquire.
+ * GCC/Clang: __atomic_*; MSVC (Windows-сборка, x86 — строгий порядок): барьер компилятора.
+ */
+#if defined(__GNUC__) || defined(__clang__)
+#  define Q_LOAD_ACQUIRE(p)       __atomic_load_n((p), __ATOMIC_ACQUIRE)
+#  define Q_STORE_RELEASE(p, v)   __atomic_store_n((p), (v), __ATOMIC_RELEASE)
+#else
+#  include <intrin.h>
+#  define Q_LOAD_ACQUIRE(p)       (_ReadWriteBarrier(), *(p))
+#  define Q_STORE_RELEASE(p, v)   (_ReadWriteBarrier(), *(p) = (v))
+#endif
+
 void MIDI_Queue_Init(void)
 {
     head = 0;
@@ -24,31 +40,31 @@ void MIDI_Queue_Init(void)
 
 bool MIDI_Queue_Push(const MIDI_Event_t *event)
 {
-    uint32_t current_head = head;
+    uint32_t current_head = head;                       /* head пишет только производитель */
     uint32_t next_head = (current_head + 1U) & (MIDI_QUEUE_SIZE - 1U);
 
-    if (next_head == tail)
+    if (next_head == Q_LOAD_ACQUIRE(&tail))
     {
         overrun_count++;
         return false;
     }
 
     queue_buffer[current_head] = *event;
-    head = next_head;
+    Q_STORE_RELEASE(&head, next_head);                  /* элемент виден потребителю только после этого */
     return true;
 }
 
 bool MIDI_Queue_Pop(MIDI_Event_t *event)
 {
-    uint32_t current_tail = tail;
+    uint32_t current_tail = tail;                       /* tail пишет только потребитель */
 
-    if (current_tail == head)
+    if (current_tail == Q_LOAD_ACQUIRE(&head))
     {
         return false;
     }
 
     *event = queue_buffer[current_tail];
-    tail = (current_tail + 1U) & (MIDI_QUEUE_SIZE - 1U);
+    Q_STORE_RELEASE(&tail, (current_tail + 1U) & (MIDI_QUEUE_SIZE - 1U));   /* слот освобождён после копирования */
     return true;
 }
 
diff --git a/Engine/midi/usb_midi_packet.c b/Engine/midi/usb_midi_packet.c
new file mode 100644
index 0000000..2920fea
--- /dev/null
+++ b/Engine/midi/usb_midi_packet.c
@@ -0,0 +1,28 @@
+#include "usb_midi_packet.h"
+
+#include <stddef.h>
+
+bool UsbMidi_PacketToEvent(const uint8_t pkt[4], MIDI_Event_t *out)
+{
+    if (pkt == NULL || out == NULL) {
+        return false;
+    }
+
+    const uint8_t cin    = pkt[0] & 0x0FU;
+    const uint8_t status = pkt[1];
+
+    /* Только голосовые сообщения канала. Статус обязан быть 0x80..0xEF (старший бит = 1, не 0xFx):
+     * так отсекаются и «пустые» пакеты, и случайный мусор вместо статус-байта. */
+    if (cin < 0x8U || cin > 0xEU) {
+        return false;
+    }
+    if ((status & 0x80U) == 0U || status >= MIDI_STATUS_SYSTEM_EXCLUSIVE) {
+        return false;
+    }
+
+    out->status = status;
+    out->data1  = pkt[2] & 0x7FU;
+    /* Program Change (0xC) и Channel Pressure (0xD) — двухбайтовые: третий байт не используется. */
+    out->data2  = (cin == 0xCU || cin == 0xDU) ? 0U : (uint8_t)(pkt[3] & 0x7FU);
+    return true;
+}
diff --git a/Engine/midi/usb_midi_packet.h b/Engine/midi/usb_midi_packet.h
new file mode 100644
index 0000000..a654d0c
--- /dev/null
+++ b/Engine/midi/usb_midi_packet.h
@@ -0,0 +1,38 @@
+#ifndef USB_MIDI_PACKET_H
+#define USB_MIDI_PACKET_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "midi_event.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @file    usb_midi_packet.h
+ * @brief   Разбор одного 4-байтового USB-MIDI Event Packet (USB MIDI 1.0, §4) в MIDI_Event_t.
+ *
+ * Чистая функция без обращений к железу: её можно тестировать на хосте и использовать из
+ * любого контекста (USB-callback, main, тесты).
+ *
+ * Пропускаются ТОЛЬКО сообщения голосового канала (Code Index Number 0x8..0xE: Note Off/On,
+ * Poly Pressure, Control Change, Program Change, Channel Pressure, Pitch Bend).
+ * Остальное отбрасывается: SysEx (CIN 0x4..0x7), System Common (0x2/0x3), одиночные байты и
+ * System Real-Time (CIN 0xF: Clock 0xF8 = 24 раза за такт, Active Sensing 0xFE каждые ~300 мс)
+ * — они не нужны синтезатору, но забивали бы очередь событий и могли вытеснить Note Off.
+ *
+ * Байты данных маскируются до 7 бит (0x7F): неисправное устройство не сможет передать
+ * движкам «ноту 200» и вывести индекс за пределы таблиц.
+ *
+ * @param pkt  4 байта пакета: [cable<<4 | CIN, status, data1, data2].
+ * @param out  Результат (меняется только при возврате true).
+ * @return true — пакет содержит событие голосового канала и записан в *out.
+ */
+bool UsbMidi_PacketToEvent(const uint8_t pkt[4], MIDI_Event_t *out);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* USB_MIDI_PACKET_H */
