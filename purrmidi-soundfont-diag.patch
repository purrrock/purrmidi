+struct DiagStats {
+    volatile uint32_t blocks;          /* audio blocks rendered in this window                         */
+    volatile uint32_t cycles_sum;      /* CPU cycles spent in SoundFontSynth_FillStereoBuffer          */
+    volatile uint32_t cycles_max;
