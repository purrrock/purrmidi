diff --git a/Engine/audio/audio_halves.c b/Engine/audio/audio_halves.c
new file mode 100644
index 0000000..2bb63e3
--- /dev/null
+++ b/Engine/audio/audio_halves.c
@@ -0,0 +1,70 @@
+#include "audio_halves.h"
+
+/* GCC/Clang (arm-none-eabi, Linux, MinGW): __atomic_*. MSVC (Windows-сборка тестов, x86 - строгий порядок):
+ * Interlocked-операции со встроенным полным барьером. */
+#if defined(__GNUC__) || defined(__clang__)
+#  define AH_LOAD_ACQ(p)        __atomic_load_n((p), __ATOMIC_ACQUIRE)
+#  define AH_STORE_REL(p, v)    __atomic_store_n((p), (v), __ATOMIC_RELEASE)
+#  define AH_FETCH_OR(p, v)     __atomic_fetch_or((p), (v), __ATOMIC_ACQ_REL)
+#  define AH_FETCH_AND(p, v)    __atomic_fetch_and((p), (v), __ATOMIC_ACQ_REL)
+#  define AH_FETCH_ADD(p, v)    __atomic_fetch_add((p), (v), __ATOMIC_RELAXED)
+#else
+#  include <intrin.h>
+#  define AH_LOAD_ACQ(p)        (_ReadWriteBarrier(), *(p))
+#  define AH_STORE_REL(p, v)    (_ReadWriteBarrier(), *(p) = (v))
+#  define AH_FETCH_OR(p, v)     ((uint32_t)_InterlockedOr((volatile long *)(p), (long)(v)))
+#  define AH_FETCH_AND(p, v)    ((uint32_t)_InterlockedAnd((volatile long *)(p), (long)(v)))
+#  define AH_FETCH_ADD(p, v)    ((uint32_t)_InterlockedExchangeAdd((volatile long *)(p), (long)(v)))
+#endif
+
+void AudioHalves_Init(AudioHalves *h)
+{
+    h->pending  = 0U;
+    h->last_req = 0U;
+    h->late     = 0U;
+}
+
+bool AudioHalves_Request(AudioHalves *h, unsigned half)
+{
+    half &= 1U;
+    const uint32_t bit   = 1U << half;
+    const uint32_t other = 1U << (half ^ 1U);
+
+    /* last_req публикуем ДО флага: читатель, увидев флаг, увидит и актуальный last_req. */
+    AH_STORE_REL(&h->last_req, half);
+    const uint32_t before = AH_FETCH_OR(&h->pending, bit);
+
+    /* Предыдущая половина ещё не готова (DMA уже читает её) или эта же так и не обработана -> опоздание. */
+    const bool late = (before & (other | bit)) != 0U;
+    if (late) {
+        (void)AH_FETCH_ADD(&h->late, 1U);
+    }
+    return late;
+}
+
+bool AudioHalves_Next(AudioHalves *h, unsigned *half, bool *stale)
+{
+    const uint32_t pend = AH_LOAD_ACQ(&h->pending);
+    if (pend == 0U) {
+        return false;
+    }
+    if (pend == 3U) {
+        /* Ждут обе: более старая - та, что запрошена не последней. Она уже играется - заливаем её тишиной. */
+        *half  = (unsigned)(AH_LOAD_ACQ(&h->last_req) ^ 1U);
+        *stale = true;
+    } else {
+        *half  = (pend & 1U) ? 0U : 1U;
+        *stale = false;
+    }
+    return true;
+}
+
+void AudioHalves_Done(AudioHalves *h, unsigned half)
+{
+    (void)AH_FETCH_AND(&h->pending, ~(1U << (half & 1U)));
+}
+
+uint32_t AudioHalves_LateCount(const AudioHalves *h)
+{
+    return AH_LOAD_ACQ(&h->late);
+}
diff --git a/Engine/audio/audio_halves.h b/Engine/audio/audio_halves.h
new file mode 100644
index 0000000..4571239
--- /dev/null
+++ b/Engine/audio/audio_halves.h
@@ -0,0 +1,64 @@
+/**
+ * @file    audio_halves.h
+ * @brief   Планировщик заполнения двух половин циклического DMA-буфера звука.
+ *
+ * Зачем: раньше синтез рендерился прямо в прерывании DMA с приоритетом 0 (как и USB), то есть блок до 2,67 мс
+ * не мог быть прерван даже USB/SDMMC. Теперь DMA-прерывание только отмечает, какая половина освободилась
+ * (AudioHalves_Request), и запускает PendSV; рендер выполняется в PendSV с самым низким приоритетом
+ * (AudioHalves_Next / AudioHalves_Done) и прерывается любым другим прерыванием.
+ *
+ * Временная диаграмма (P = период половины, 2,67 мс):
+ *   Request(0) в момент T   - DMA играет половину 1, половина 0 свободна; её надо заполнить до T + P.
+ *   Request(1) в момент T+P - DMA перешёл на половину 0 (!), половина 1 свободна.
+ *   Если в момент Request(1) половина 0 ещё не заполнена (флаг pending), крайний срок пропущен: DMA уже играет
+ *   недозаполненную половину 0 - это «опоздание» (late), оно считается и сообщается пользователю.
+ *
+ * Модуль не обращается к железу и состоит из двух сторон:
+ *   - Request(): только из прерывания DMA (один писатель, самый высокий приоритет из двух сторон);
+ *   - Next()/Done(): только из PendSV (один читатель).
+ * Синхронизация - атомарные операции с acquire/release, критические секции не нужны.
+ */
+#ifndef AUDIO_HALVES_H
+#define AUDIO_HALVES_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+    volatile uint32_t pending;    /* бит 0 - половина 0 ждёт заполнения, бит 1 - половина 1 */
+    volatile uint32_t last_req;   /* какая половина запрошена последней (0/1)               */
+    volatile uint32_t late;       /* сколько раз крайний срок был пропущен                  */
+} AudioHalves;
+
+void AudioHalves_Init(AudioHalves *h);
+
+/**
+ * Прерывание DMA: половина `half` (0 или 1) освободилась и ждёт новых данных.
+ * @return true, если предыдущий запрос ещё не выполнен (опоздание: DMA уже играет недозаполненную половину).
+ */
+bool AudioHalves_Request(AudioHalves *h, unsigned half);
+
+/**
+ * PendSV: выбрать следующую половину для обработки.
+ * @param half   [out] номер половины (0/1).
+ * @param stale  [out] true - эту половину рендерить НЕ нужно, а залить тишиной: ждут обе половины, значит
+ *               более старая уже пропустила свой срок и DMA её проигрывает (повтор старого звука хуже тишины).
+ * @return false, если делать нечего.
+ */
+bool AudioHalves_Next(AudioHalves *h, unsigned *half, bool *stale);
+
+/** PendSV: половина `half` обработана (отрендерена или залита тишиной). */
+void AudioHalves_Done(AudioHalves *h, unsigned half);
+
+/** Счётчик пропущенных сроков (для статистики и индикации на дисплее). */
+uint32_t AudioHalves_LateCount(const AudioHalves *h);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* AUDIO_HALVES_H */
