     if (e) {
         e->control_change(control, value);
@@ -160,6 +217,7 @@ void SynthEngine_FillStereoBuffer(int16_t *buffer, uint32_t num_frames)
     const Engine *e = g_active.load(std::memory_order_relaxed);
     if (e) {
