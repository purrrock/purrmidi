diff --git a/README.md b/README.md
index a0c9830..4efed33 100644
--- a/README.md
+++ b/README.md
@@ -111,6 +111,19 @@ E-Piano → Pluck → Sine → Organ → SoundFont
 
 Для кнопки, назначенной на переключение следующего инструмента, следует использовать MIDI Program Change со значением `127`. Например, это позволяет использовать кнопку SUS контроллера для последовательного перебора звуков, если контроллер можно настроить на отправку такого сообщения.
 
+### Общая громкость (MIDI CC7)
+
+Громкость всего синтезатора регулируется с MIDI-клавиатуры сообщением Control Change **CC7** (Channel Volume) — его обычно шлют ползунок или ручка громкости. Канал не учитывается.
+
+У PCM5102A нет аппаратной регулировки громкости (у него нет ни I2C, ни SPI; из управляющих выводов только FLT, DEMP, XSMT и FMT), поэтому громкость меняется программно: `SynthEngine_FillStereoBuffer()` умножает выходные отсчёты активного движка на коэффициент. Это работает одинаково для всех пяти движков и не сбрасывается при смене инструмента.
+
+* Кривая квадратичная: `127` → 1.0 (без ослабления), `64` → ≈0.25 (−12 дБ), `0` → тишина.
+* Коэффициент меняется плавно внутри блока, поэтому щелчков при вращении ручки нет.
+* После включения питания громкость равна `127` (как до появления регулировки).
+* CC7 перехватывается в `SynthEngine_ControlChange()` и в движки не передаётся (иначе громкость применялась бы дважды).
+* Номер контроллера и стартовый уровень переопределяются макросами `SYNTH_MASTER_VOLUME_CC` и `SYNTH_MASTER_VOLUME_DEFAULT` (`Engine/synth/synth_engine.h`).
+* Программный доступ: `SynthEngine_SetMasterVolume()` и `SynthEngine_GetMasterVolume()`.
+
 ### Общий интерфейс движков
 
 Основные функции общего API:
diff --git a/tests/test_synth_switch.cpp b/tests/test_synth_switch.cpp
index e67774b..9acd6d8 100644
--- a/tests/test_synth_switch.cpp
+++ b/tests/test_synth_switch.cpp
@@ -244,6 +244,53 @@ static void test_switch_while_audio_running() {
     CHECK(static_cast<int>(SynthEngine_GetCurrent()) < SYNTH_ENGINE_COUNT);
 }
 
+static void send_cc(uint8_t cc, uint8_t value, uint8_t channel = 0) {
+    MIDI_Event_t e = {static_cast<uint8_t>(MIDI_STATUS_CONTROL_CHANGE | channel), cc, value};
+    MIDI_Dispatch(&e);
+}
+
+// Общая громкость: CC7 с клавиатуры масштабирует выход любого движка (программно, т.к. у PCM5102A нет регулировки).
+static void test_master_volume_cc7() {
+    SynthEngine_Init();
+    CHECK(SynthEngine_GetMasterVolume() == SYNTH_MASTER_VOLUME_DEFAULT);
+
+    // Берём движок Sine: стабильная амплитуда, удобно сравнивать пики.
+    send_pc(2);
+    send_note_on(69, 127);
+    render_peak(2400);                       // даём прогреться и применить события
+    const int full = render_peak(4800);
+    CHECK(full > 0);
+
+    send_cc(SYNTH_MASTER_VOLUME_CC, 64);
+    CHECK(SynthEngine_GetMasterVolume() == 64);
+    render_peak(480);                        // блок с плавным переходом
+    const int half = render_peak(4800);
+    CHECK(half > 0);
+    CHECK(half < full / 2);                  // квадратичная кривая: 64/127 -> ≈0.25
+    CHECK(half > full / 8);
+
+    send_cc(SYNTH_MASTER_VOLUME_CC, 0);
+    render_peak(480);
+    CHECK(render_peak(4800) == 0);           // полная тишина
+
+    send_cc(SYNTH_MASTER_VOLUME_CC, 127, 5); // канал не важен, возврат к полному уровню
+    render_peak(480);
+    const int back = render_peak(4800);
+    CHECK(back >= full - full / 20 && back <= full + full / 20);
+
+    // Громкость не сбрасывается при смене движка.
+    send_cc(SYNTH_MASTER_VOLUME_CC, 40);
+    send_pc(0);
+    CHECK(SynthEngine_GetMasterVolume() == 40);
+
+    // Прямой API ограничивает значение сверху.
+    SynthEngine_SetMasterVolume(200);
+    CHECK(SynthEngine_GetMasterVolume() == 127);
+
+    SynthEngine_Init();                      // Init возвращает значение по умолчанию
+    CHECK(SynthEngine_GetMasterVolume() == SYNTH_MASTER_VOLUME_DEFAULT);
+}
+
