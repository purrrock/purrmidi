+/**
+ * @file    qspi_flash.c
+ * @brief   Драйвер QSPI Flash Winbond W25Q64 на HAL_QSPI (indirect + memory-mapped). См. qspi_flash.h.
+ */
+#include "qspi_flash.h"
+#include "xip_mpu.h"
+
+#include "main.h"
+#include "quadspi.h"          /* extern QSPI_HandleTypeDef hqspi; void MX_QUADSPI_Init(void); (генерирует CubeMX) */
+
+#include <stdio.h>
+#include <string.h>
+
+/* Коды команд Winbond W25Qxx */
+#define CMD_WRITE_ENABLE     0x06U
+#define CMD_READ_SR1         0x05U
+#define CMD_READ_SR2         0x35U
+#define CMD_WRITE_SR2        0x31U
+#define CMD_SECTOR_ERASE_4K  0x20U
+#define CMD_BLOCK_ERASE_64K  0xD8U
+#define CMD_PAGE_PROGRAM     0x02U
+#define CMD_FAST_READ_QUAD   0xEBU
+#define CMD_JEDEC_ID         0x9FU
+#define CMD_RESET_ENABLE     0x66U
+#define CMD_RESET            0x99U
+
+#define SR1_BUSY             0x01U
+#define SR1_WEL              0x02U
+#define SR2_QE               0x02U
+
+#define TIMEOUT_CMD_MS       100U
+#define TIMEOUT_PAGE_MS      100U      /* tPP max 3 мс */
+#define TIMEOUT_SECTOR_MS    1000U     /* t_SE max 400 мс */
+#define TIMEOUT_BLOCK_MS     3000U     /* t_BE64 max 2 с */
+#define TIMEOUT_SR_MS        100U
+
+#define READ_CHUNK           0x10000U
+
+static bool    s_inited;
+static bool    s_mapped;
+static uint8_t s_jedec[3];
+
+/* ------------------------------ команды ------------------------------------ */
+
+static void cmd_init(QSPI_CommandTypeDef *c, uint8_t instruction)
+{
+    memset(c, 0, sizeof(*c));
+    c->Instruction       = instruction;
+    c->InstructionMode   = QSPI_INSTRUCTION_1_LINE;
+    c->AddressMode       = QSPI_ADDRESS_NONE;
+    c->AlternateByteMode = QSPI_ALTERNATE_BYTES_NONE;
+    c->DataMode          = QSPI_DATA_NONE;
+    c->DdrMode           = QSPI_DDR_MODE_DISABLE;
+    c->DdrHoldHalfCycle  = QSPI_DDR_HHC_ANALOG_DELAY;
+    c->SIOOMode          = QSPI_SIOO_INST_EVERY_CMD;
+}
+
+/* Быстрое чтение 0xEB: инструкция - 1 линия, адрес/режимный байт/данные - 4 линии.
+ * Режимный байт 0x00: старшие 4 бита не равны 0xA, значит "continuous read mode" не включается
+ * и каждая последующая команда (в том числе стирание) работает как обычно. */
+static void cmd_quad_read(QSPI_CommandTypeDef *c, uint32_t addr, uint32_t nbytes)
+{
+    cmd_init(c, CMD_FAST_READ_QUAD);
+    c->AddressMode        = QSPI_ADDRESS_4_LINES;
+    c->AddressSize        = QSPI_ADDRESS_24_BITS;
+    c->Address            = addr;
+    c->AlternateByteMode  = QSPI_ALTERNATE_BYTES_4_LINES;
+    c->AlternateBytesSize = QSPI_ALTERNATE_BYTES_8_BITS;
+    c->AlternateBytes     = 0x00U;
+    c->DummyCycles        = QSPIFLASH_READ_DUMMY_CYCLES;
+    c->DataMode           = QSPI_DATA_4_LINES;
+    c->NbData             = nbytes;
+}
+
+static bool fail(void)
+{
+    (void)HAL_QSPI_Abort(&hqspi);   /* вернуть контроллер в READY */
+    return false;
+}
+
+static bool simple_cmd(uint8_t instruction)
+{
+    QSPI_CommandTypeDef c;
+    cmd_init(&c, instruction);
+    return HAL_QSPI_Command(&hqspi, &c, TIMEOUT_CMD_MS) == HAL_OK;
+}
+
+static bool read_reg(uint8_t instruction, uint8_t *value)
+{
+    QSPI_CommandTypeDef c;
+    cmd_init(&c, instruction);
+    c.DataMode = QSPI_DATA_1_LINE;
+    c.NbData   = 1;
+    if (HAL_QSPI_Command(&hqspi, &c, TIMEOUT_CMD_MS) != HAL_OK) return false;
+    return HAL_QSPI_Receive(&hqspi, value, TIMEOUT_SR_MS) == HAL_OK;
+}
+
+/* Аппаратный опрос SR1: ждём (SR1 & mask) == match. */
+static bool poll_sr1(uint8_t mask, uint8_t match, uint32_t timeout_ms)
+{
+    QSPI_CommandTypeDef c;
+    QSPI_AutoPollingTypeDef p;
+
+    cmd_init(&c, CMD_READ_SR1);
+    c.DataMode = QSPI_DATA_1_LINE;
+    c.NbData   = 1;
+
+    memset(&p, 0, sizeof(p));
+    p.Match           = match;
+    p.Mask            = mask;
+    p.MatchMode       = QSPI_MATCH_MODE_AND;
+    p.StatusBytesSize = 1;
+    p.Interval        = 0x10;
+    p.AutomaticStop   = QSPI_AUTOMATIC_STOP_ENABLE;
+    return HAL_QSPI_AutoPolling(&hqspi, &c, &p, timeout_ms) == HAL_OK;
+}
+
+static bool wait_ready(uint32_t timeout_ms)
+{
+    return poll_sr1(SR1_BUSY, 0x00U, timeout_ms);
+}
+
+static bool write_enable(void)
+{
+    if (!simple_cmd(CMD_WRITE_ENABLE)) return false;
+    return poll_sr1(SR1_WEL, SR1_WEL, TIMEOUT_SR_MS);
+}
+
+static bool ensure_indirect(void)
+{
+    if (s_mapped) {
+        QSPIFlash_Unmap();
+    }
+    return s_inited;
+}
+
+/* ------------------------------ публичный API ------------------------------ */
+
+bool QSPIFlash_Init(void)
+{
+    if (s_inited) return true;
+
+    if (hqspi.State == HAL_QSPI_STATE_RESET) {
+        MX_QUADSPI_Init();
+    }
+    (void)HAL_QSPI_Abort(&hqspi);
+
+    /* Программный сброс флеша: убирает любое "полузавершённое" состояние после перезагрузки MCU. */
+    if (!simple_cmd(CMD_RESET_ENABLE) || !simple_cmd(CMD_RESET)) {
+        printf("[QSPI] reset command failed\r\n");
+        return false;
+    }
+    HAL_Delay(2);   /* tRST ~30 мкс, с запасом */
+
+    QSPI_CommandTypeDef c;
+    cmd_init(&c, CMD_JEDEC_ID);
+    c.DataMode = QSPI_DATA_1_LINE;
+    c.NbData   = 3;
+    if (HAL_QSPI_Command(&hqspi, &c, TIMEOUT_CMD_MS) != HAL_OK ||
+        HAL_QSPI_Receive(&hqspi, s_jedec, TIMEOUT_SR_MS) != HAL_OK) {
+        printf("[QSPI] cannot read JEDEC ID (check pins/clock in CubeMX)\r\n");
+        return fail();
+    }
+    printf("[QSPI] JEDEC ID %02X %02X %02X\r\n", s_jedec[0], s_jedec[1], s_jedec[2]);
+
+    /* Третий байт - log2 ёмкости в байтах (0x17 -> 8 МБ). 0x00/0xFF - шина не работает. */
+    if (s_jedec[2] < 0x10U || s_jedec[2] > 0x1FU || (1UL << s_jedec[2]) < QSPIFLASH_SIZE) {
+        printf("[QSPI] unexpected capacity code 0x%02X (need >= 8 MB)\r\n", s_jedec[2]);
+        return false;
+    }
+
+    /* Quad Enable: без него IO2/IO3 работают как WP#/HOLD# и 4-проводное чтение невозможно. */
+    uint8_t sr2 = 0;
+    if (!read_reg(CMD_READ_SR2, &sr2)) return fail();
+    if ((sr2 & SR2_QE) == 0U) {
+        const uint8_t v = (uint8_t)(sr2 | SR2_QE);
+
+        if (!write_enable()) return fail();
+        cmd_init(&c, CMD_WRITE_SR2);
+        c.DataMode = QSPI_DATA_1_LINE;
+        c.NbData   = 1;
+        if (HAL_QSPI_Command(&hqspi, &c, TIMEOUT_CMD_MS) != HAL_OK ||
+            HAL_QSPI_Transmit(&hqspi, (uint8_t *)&v, TIMEOUT_SR_MS) != HAL_OK) {
+            return fail();
+        }
+        if (!wait_ready(TIMEOUT_SECTOR_MS)) return fail();
+        if (!read_reg(CMD_READ_SR2, &sr2) || (sr2 & SR2_QE) == 0U) {
+            printf("[QSPI] cannot set Quad Enable (SR2=0x%02X)\r\n", sr2);
+            return false;
+        }
+        printf("[QSPI] Quad Enable bit set\r\n");
+    }
+
+    s_inited = true;
+    return true;
+}
+
+void QSPIFlash_GetJedecId(uint8_t id[3])
+{
+    memcpy(id, s_jedec, 3);
+}
+
+bool QSPIFlash_Read(uint32_t addr, void *dst, uint32_t len)
+{
+    uint8_t *p = (uint8_t *)dst;
+
+    if (!ensure_indirect() || (uint64_t)addr + len > QSPIFLASH_SIZE) return false;
+    while (len) {
+        const uint32_t n = (len > READ_CHUNK) ? READ_CHUNK : len;
+        QSPI_CommandTypeDef c;
+
+        cmd_quad_read(&c, addr, n);
+        if (HAL_QSPI_Command(&hqspi, &c, TIMEOUT_CMD_MS) != HAL_OK) return fail();
+        if (HAL_QSPI_Receive(&hqspi, p, TIMEOUT_SECTOR_MS) != HAL_OK) return fail();
+        addr += n;
+        p += n;
+        len -= n;
+    }
+    return true;
+}
+
+static bool erase(uint8_t instruction, uint32_t addr, uint32_t unit, uint32_t timeout_ms)
+{
+    if (!ensure_indirect() || (addr % unit) != 0U || addr + unit > QSPIFLASH_SIZE) return false;
+    if (!write_enable()) return fail();
+
+    QSPI_CommandTypeDef c;
+    cmd_init(&c, instruction);
+    c.AddressMode = QSPI_ADDRESS_1_LINE;
+    c.AddressSize = QSPI_ADDRESS_24_BITS;
+    c.Address     = addr;
+    if (HAL_QSPI_Command(&hqspi, &c, TIMEOUT_CMD_MS) != HAL_OK) return fail();
+    return wait_ready(timeout_ms) ? true : fail();
+}
+
+bool QSPIFlash_EraseSector(uint32_t addr)  { return erase(CMD_SECTOR_ERASE_4K, addr, 0x1000U, TIMEOUT_SECTOR_MS); }
+bool QSPIFlash_EraseBlock64(uint32_t addr) { return erase(CMD_BLOCK_ERASE_64K, addr, 0x10000U, TIMEOUT_BLOCK_MS); }
+
+bool QSPIFlash_ProgramPage(uint32_t addr, const void *src, uint32_t len)
+{
+    if (!ensure_indirect() || len == 0U || len > 256U || ((addr & 0xFFU) + len) > 256U ||
+        (uint64_t)addr + len > QSPIFLASH_SIZE) {
+        return false;
+    }
+    if (!write_enable()) return fail();
+
+    QSPI_CommandTypeDef c;
+    cmd_init(&c, CMD_PAGE_PROGRAM);
+    c.AddressMode = QSPI_ADDRESS_1_LINE;
+    c.AddressSize = QSPI_ADDRESS_24_BITS;
+    c.Address     = addr;
+    c.DataMode    = QSPI_DATA_1_LINE;
+    c.NbData      = len;
+    if (HAL_QSPI_Command(&hqspi, &c, TIMEOUT_CMD_MS) != HAL_OK) return fail();
+    if (HAL_QSPI_Transmit(&hqspi, (uint8_t *)src, TIMEOUT_PAGE_MS) != HAL_OK) return fail();
+    return wait_ready(TIMEOUT_PAGE_MS) ? true : fail();
+}
+
+bool QSPIFlash_MemoryMap(const uint8_t **base)
+{
+    if (!s_inited) return false;
+    if (s_mapped) {
+        if (base) *base = (const uint8_t *)QSPIFLASH_XIP_BASE;
+        return true;
+    }
+
+    QSPI_CommandTypeDef c;
+    QSPI_MemoryMappedTypeDef m;
+
+    cmd_quad_read(&c, 0, 0);
+    memset(&m, 0, sizeof(m));
+    m.TimeOutPeriod     = 0;
+    m.TimeOutActivation = QSPI_TIMEOUT_COUNTER_DISABLE;
+    if (HAL_QSPI_MemoryMapped(&hqspi, &c, &m) != HAL_OK) return fail();
+
+    s_mapped = true;
+    XipMpu_SetXipEnabled(true);     /* кэшируемое окно открывается только когда отображение уже работает */
+    if (base) *base = (const uint8_t *)QSPIFLASH_XIP_BASE;
+    return true;
+}
+
+void QSPIFlash_Unmap(void)
+{
+    if (!s_mapped) return;
+    XipMpu_SetXipEnabled(false);
+    s_mapped = false;
+    (void)HAL_QSPI_Abort(&hqspi);
+}
+
+bool QSPIFlash_IsMapped(void)
+{
+    return s_mapped;
+}
diff --git a/Platform/qspi_xip/qspi_flash.h b/Platform/qspi_xip/qspi_flash.h
new file mode 100644
index 0000000..dd2835b
--- /dev/null
+++ b/Platform/qspi_xip/qspi_flash.h
@@ -0,0 +1,57 @@
+/**
+ * @file    qspi_flash.h
+ * @brief   Драйвер внешней QSPI Flash (Winbond W25Q64, 8 МБ, WeAct STM32H743 Mini) на HAL_QSPI.
+ *
+ * Два режима:
+ *   - indirect: чтение (0xEB), стирание 4 КБ / 64 КБ, запись страниц по 256 Б;
+ *   - memory-mapped (XIP): флеш отображается в 0x90000000 только для чтения (команда 0xEB, 4 линии).
+ *
+ * Требования к CubeMX: см. docs/QSPI_XIP.md (QUADSPI, Bank1, 4 линии, Flash Size 23 бита, генерация quadspi.c).
+ * Драйвер вызывает MX_QUADSPI_Init() сам, если CubeMX не сделал это раньше.
+ * Для других микросхем (не Winbond) нужно проверить коды команд и число dummy-циклов.
+ */
+#ifndef QSPI_FLASH_H
+#define QSPI_FLASH_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifndef QSPIFLASH_XIP_BASE
+#define QSPIFLASH_XIP_BASE        0x90000000UL
+#endif
+
+#ifndef QSPIFLASH_SIZE
+#define QSPIFLASH_SIZE            0x800000UL      /* 8 МБ */
+#endif
+
+/* Dummy-циклы команды 0xEB. W25Q64: 2 такта режимного байта (передаётся как AlternateBytes) + 4 dummy. */
+#ifndef QSPIFLASH_READ_DUMMY_CYCLES
+#define QSPIFLASH_READ_DUMMY_CYCLES  4U
+#endif
+
+/** Сброс флеша, чтение JEDEC ID, проверка ёмкости, включение Quad Enable (бит QE в SR2). */
+bool QSPIFlash_Init(void);
+
+/** JEDEC ID (производитель, тип, ёмкость), заполняется в QSPIFlash_Init(). */
+void QSPIFlash_GetJedecId(uint8_t id[3]);
+
+/* Indirect-режим. Если включён XIP, функции сами из него выходят. Адреса - смещения от начала флеша. */
+bool QSPIFlash_Read(uint32_t addr, void *dst, uint32_t len);
+bool QSPIFlash_EraseSector(uint32_t addr);                         /* 4 КБ, addr кратен 4096   */
+bool QSPIFlash_EraseBlock64(uint32_t addr);                        /* 64 КБ, addr кратен 65536 */
+bool QSPIFlash_ProgramPage(uint32_t addr, const void *src, uint32_t len);   /* len <= 256, в пределах страницы */
+
+/* Memory-mapped (XIP). */
+bool QSPIFlash_MemoryMap(const uint8_t **base);
+void QSPIFlash_Unmap(void);
+bool QSPIFlash_IsMapped(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* QSPI_FLASH_H */
diff --git a/Platform/qspi_xip/sf2_loader.c b/Platform/qspi_xip/sf2_loader.c
new file mode 100644
index 0000000..c358af4
--- /dev/null
+++ b/Platform/qspi_xip/sf2_loader.c
@@ -0,0 +1,206 @@
+/**
+ * @file    sf2_loader.c
+ * @brief   Склейка ядра загрузчика (sf2_loader_core) с FatFs/SD и драйвером QSPI Flash.
+ */
+#include "sf2_loader.h"
+#include "qspi_flash.h"
+
+#include "main.h"
+#include "ff.h"
+#include "sd_storage.h"
+#include "display.h"
+
+#include <stdio.h>
+#include <string.h>
+
+/* Буфер обмена SD -> QSPI. AXI SRAM: IDMA SDMMC1 читает прямо в него (без bounce-копии). Кратен 256. */
+#ifndef SF2_XFER_BYTES
+#define SF2_XFER_BYTES  8192U
+#endif
+static uint8_t s_xfer[SF2_XFER_BYTES] __attribute__((section(".dma_buffer"), aligned(32)));
+
+static FIL            s_file;
+static bool           s_file_open;
+static bool           s_sd_mounted_by_us;
+static bool           s_done;
+static bool           s_ok;
+static bool           s_progress_shown;
+static SF2L_Report    s_report;
+
+/* ------------------------------ источник: SD ------------------------------- */
+
+static SF2SrcStatus src_open(void *ctx, uint32_t *size, uint32_t *stamp)
+{
+    (void)ctx;
+
+    if (!SDStorage_CardPresent()) {
+        return SF2SRC_NO_MEDIA;
+    }
+    if (!SDStorage_IsMounted()) {
+        const SDStorage_Result r = SDStorage_Mount();
+        if (r != SDS_OK) {
+            printf("[SF2] SD card not usable: %s\r\n", SDStorage_ResultName(r));
+            return SF2SRC_NO_MEDIA;
+        }
+        s_sd_mounted_by_us = true;
+    }
+
+    FILINFO fno;
+    FRESULT fr = f_stat(SF2_SD_PATH, &fno);
+    if (fr == FR_NO_FILE || fr == FR_NO_PATH) {
+        return SF2SRC_NO_FILE;
+    }
+    if (fr != FR_OK) {
+        printf("[SF2] f_stat failed: FRESULT=%d\r\n", (int)fr);
+        return SF2SRC_ERROR;
+    }
+    fr = f_open(&s_file, SF2_SD_PATH, FA_READ);
+    if (fr != FR_OK) {
+        printf("[SF2] f_open failed: FRESULT=%d\r\n", (int)fr);
+        return SF2SRC_ERROR;
+    }
+    s_file_open = true;
+
+    *size  = ((uint64_t)fno.fsize > 0xFFFFFFFFULL) ? 0xFFFFFFFFUL : (uint32_t)fno.fsize;
+    *stamp = ((uint32_t)fno.fdate << 16) | (uint32_t)fno.ftime;
+    return SF2SRC_OK;
+}
+
+static bool src_read(void *ctx, void *dst, uint32_t len, uint32_t *got)
+{
+    (void)ctx;
+    UINT br = 0;
+
+    if (!s_file_open || f_read(&s_file, dst, (UINT)len, &br) != FR_OK) {
+        return false;
+    }
+    *got = (uint32_t)br;
+    return true;
+}
+
+static bool src_rewind(void *ctx)
+{
+    (void)ctx;
+    return s_file_open && f_lseek(&s_file, 0) == FR_OK;
+}
+
+static void src_close(void *ctx)
+{
+    (void)ctx;
+    if (s_file_open) {
+        f_close(&s_file);
+        s_file_open = false;
+    }
+}
+
+static const SF2SourceOps s_src_ops = { src_open, src_read, src_rewind, src_close };
+
+/* ------------------------------ флеш: QSPI --------------------------------- */
+
+static bool op_read(void *c, uint32_t a, void *d, uint32_t n)          { (void)c; return QSPIFlash_Read(a, d, n); }
+static bool op_erase_sector(void *c, uint32_t a)                       { (void)c; return QSPIFlash_EraseSector(a); }
+static bool op_erase_block(void *c, uint32_t a)                        { (void)c; return QSPIFlash_EraseBlock64(a); }
+static bool op_program(void *c, uint32_t a, const void *s, uint32_t n) { (void)c; return QSPIFlash_ProgramPage(a, s, n); }
+static bool op_map(void *c, const uint8_t **b)                         { (void)c; return QSPIFlash_MemoryMap(b); }
+static void op_unmap(void *c)                                          { (void)c; QSPIFlash_Unmap(); }
+
+static const SF2FlashOps s_flash_ops = {
+    QSPIFLASH_SIZE, op_read, op_erase_sector, op_erase_block, op_program, op_map, op_unmap
+};
+
+/* ------------------------------ прогресс ----------------------------------- */
+
+static void on_progress(void *ctx, SF2L_Phase phase, uint32_t done, uint32_t total)
+{
+    static const char *const names[] = { "SF2 check", "SF2 erase", "SF2 write", "SF2 verify" };
+    static SF2L_Phase last_phase = (SF2L_Phase)0xFF;
+    static int        last_pct   = -1;
+    static uint32_t   last_tick  = 0;
+    static int        last_print = -1;
+    (void)ctx;
+
+    const int pct = total ? (int)(((uint64_t)done * 100U) / total) : 100;
+    const uint32_t now = HAL_GetTick();
+
+    if (phase != last_phase) {
+        last_phase = phase;
+        last_pct = -1;
+        last_print = -1;
+        printf("[SF2] %s...\r\n", names[phase]);
+    }
+    if (pct / 10 != last_print) {
+        last_print = pct / 10;
+        printf("[SF2] %s %d%%\r\n", names[phase], pct);
+    }
+    /* Дисплей: не чаще раза в 100 мс и только при изменении процента (SPI-вывод медленный). */
+    if (pct != last_pct && (pct == 100 || (now - last_tick) >= 100U)) {
+        char line[24];
+        snprintf(line, sizeof(line), "%s %d%%", names[phase], pct);
+        Display_ShowBootProgress(line, (uint8_t)pct);
+        s_progress_shown = true;
+        last_pct = pct;
+        last_tick = now;
+    }
+}
+
+/* ------------------------------ API ---------------------------------------- */
+
+bool SF2Loader_Ensure(void)
+{
+    if (s_done) {
+        return s_ok;
+    }
+    s_done = true;
+
+    printf("[SF2] QSPI XIP loader: init QSPI flash\r\n");
+    if (!QSPIFlash_Init()) {
+        printf("[SF2] QSPI flash init FAILED\r\n");
+        return false;
+    }
+
+    SF2L_Env env;
+    memset(&env, 0, sizeof(env));
+    env.flash        = &s_flash_ops;
+    env.src          = &s_src_ops;
+    env.buf          = s_xfer;
+    env.buf_size     = sizeof(s_xfer);
+    env.progress     = on_progress;
+
+    const uint32_t t0 = HAL_GetTick();
+    const SF2L_Result r = SF2L_Run(&env, &s_report);
+    const uint32_t dt = HAL_GetTick() - t0;
+
+    if (s_sd_mounted_by_us) {
+        SDStorage_Unmount();        /* SD после обновления не нужна: синтезатор читает только XIP */
+        s_sd_mounted_by_us = false;
+    }
+    if (s_progress_shown) {
+        Display_EndBootProgress();
+        s_progress_shown = false;
+    }
+
+    printf("[SF2] SD file: %s\r\n", SF2L_FileStatusName(s_report.file_status));
+    printf("[SF2] Result: %s (%lu ms)\r\n", SF2L_ResultName(r), (unsigned long)dt);
+
+    s_ok = (r == SF2L_OK_UNCHANGED || r == SF2L_OK_UPDATED);
+    if (s_ok) {
+        printf("[SF2] XIP bank at %p, %lu bytes, CRC32 %08lX\r\n", (const void *)s_report.base,
+               (unsigned long)s_report.size, (unsigned long)s_report.crc32);
+    }
+    return s_ok;
+}
+
+bool SF2Loader_GetBank(const uint8_t **base, uint32_t *size)
+{
+    if (!s_ok || s_report.base == NULL) {
+        return false;
+    }
+    if (base) *base = s_report.base;
+    if (size) *size = s_report.size;
+    return true;
+}
+
+const SF2L_Report *SF2Loader_GetReport(void)
+{
+    return &s_report;
+}
diff --git a/Platform/qspi_xip/sf2_loader.h b/Platform/qspi_xip/sf2_loader.h
new file mode 100644
index 0000000..5a401e0
--- /dev/null
+++ b/Platform/qspi_xip/sf2_loader.h
@@ -0,0 +1,42 @@
+/**
+ * @file    sf2_loader.h
+ * @brief   Загрузка SoundFont-банка в QSPI Flash с SD-карты и включение XIP (0x90000000).
+ *
+ * Вызывается один раз при старте (из SF2Cache_OpenFile(), т.е. из SoundFontSynth_InitSF2()):
+ *   1. инициализация QSPI Flash;
+ *   2. если есть SD-карта с 0:/SNDFNT.SF2 - проверка (RIFF/sfbk, размер, CRC32 против заголовка во флеше);
+ *   3. новый/изменённый файл - стирание и запись, проверка CRC32 через XIP, запись заголовка;
+ *   4. QSPI переводится в Memory-Mapped режим; синтезатор читает сэмплы напрямую по указателям.
+ * Повторные вызовы возвращают результат первого.
+ */
+#ifndef SF2_LOADER_H
+#define SF2_LOADER_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "sf2_loader_core.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Путь файла банка на SD-карте. */
+#ifndef SF2_SD_PATH
+#define SF2_SD_PATH "0:/SNDFNT.SF2"
+#endif
+
+/** Выполняет сценарий загрузки один раз. true - банк доступен через XIP. */
+bool SF2Loader_Ensure(void);
+
+/** Указатель на начало банка в XIP-окне и его размер. false, если банка нет. */
+bool SF2Loader_GetBank(const uint8_t **base, uint32_t *size);
+
+/** Результат последнего выполнения сценария (для диагностики). */
+const SF2L_Report *SF2Loader_GetReport(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SF2_LOADER_H */
diff --git a/Platform/qspi_xip/sf2_loader_core.c b/Platform/qspi_xip/sf2_loader_core.c
new file mode 100644
index 0000000..54d13aa
--- /dev/null
+++ b/Platform/qspi_xip/sf2_loader_core.c
@@ -0,0 +1,296 @@
+/**
+ * @file    sf2_loader_core.c
+ * @brief   Реализация сценария обновления SoundFont-банка в QSPI Flash (см. sf2_loader_core.h).
+ */
+#include "sf2_loader_core.h"
+#include "pm_crc32.h"
+
+#include <string.h>
+
+_Static_assert(sizeof(SF2L_Header) == 64, "SF2L_Header must be 64 bytes");
+
+#define PROGRESS(e, ph, d, t) \
+    do { if ((e)->progress) { (e)->progress((e)->progress_ctx, (ph), (d), (t)); } } while (0)
+
+static uint32_t rd32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+bool SF2L_SignatureOk(const uint8_t head12[12], uint32_t total_size)
+{
+    if (memcmp(head12, "RIFF", 4) != 0 || memcmp(head12 + 8, "sfbk", 4) != 0) {
+        return false;
+    }
+    /* Размер RIFF не включает 8 байт заголовка; он не может выходить за пределы файла. */
+    const uint32_t riff = rd32(head12 + 4);
+    return riff >= 4u && (uint64_t)riff + 8u <= total_size;
+}
+
+const char *SF2L_ResultName(SF2L_Result r)
+{
+    switch (r) {
+        case SF2L_OK_UNCHANGED: return "OK (bank unchanged)";
+        case SF2L_OK_UPDATED:   return "OK (bank updated from SD)";
+        case SF2L_ERR_PARAM:    return "bad parameters";
+        case SF2L_ERR_NO_BANK:  return "no valid bank in QSPI flash";
+        case SF2L_ERR_WRITE:    return "QSPI erase/program failed";
+        case SF2L_ERR_VERIFY:   return "verify after write failed";
+        case SF2L_ERR_FLASH:    return "QSPI memory-mapped mode failed";
+    }
+    return "?";
+}
+
+const char *SF2L_FileStatusName(SF2L_FileStatus s)
+{
+    switch (s) {
+        case SF2L_FILE_NOT_CHECKED:  return "not checked";
+        case SF2L_FILE_NO_MEDIA:     return "no SD card";
+        case SF2L_FILE_NO_FILE:      return "no SNDFNT.SF2 on card";
+        case SF2L_FILE_READ_ERROR:   return "SD read error";
+        case SF2L_FILE_TOO_SMALL:    return "file too small";
+        case SF2L_FILE_TOO_LARGE:    return "file larger than QSPI capacity";
+        case SF2L_FILE_BAD_SIGNATURE:return "not a valid RIFF/sfbk file";
+        case SF2L_FILE_SAME:         return "same as bank in flash";
+        case SF2L_FILE_NEW:          return "new file";
+    }
+    return "?";
+}
+
+/* ---------------------------- заголовок ------------------------------------ */
+
+static uint32_t header_crc(const SF2L_Header *h)
+{
+    return PM_Crc32_Update(0, h, offsetof(SF2L_Header, header_crc32));
+}
+
+static void header_build(SF2L_Header *h, uint32_t size, uint32_t crc, uint32_t stamp)
+{
+    memset(h, 0xFF, sizeof(*h));
+    h->magic      = SF2L_MAGIC;
+    h->layout     = SF2L_LAYOUT;
+    h->bank_size  = size;
+    h->bank_crc32 = crc;
+    h->src_stamp  = stamp;
+    h->header_crc32 = header_crc(h);
+}
+
+static bool header_valid(const SF2L_Header *h, uint32_t bank_max)
+{
+    return h->magic == SF2L_MAGIC && h->layout == SF2L_LAYOUT &&
+           h->bank_size >= SF2L_BANK_MIN_SIZE && h->bank_size <= bank_max &&
+           h->header_crc32 == header_crc(h);
+}
+
+/* Банк во флеше валиден: заголовок цел и в начале данных стоит сигнатура SF2. */
+static bool flash_bank_valid(const SF2L_Env *e, uint32_t bank_max, SF2L_Header *hdr)
+{
+    const SF2FlashOps *fl = e->flash;
+    uint8_t head[12];
+
+    if (!fl->read(e->flash_ctx, fl->flash_size - SF2L_SECTOR_SIZE, hdr, sizeof(*hdr))) {
+        return false;
+    }
+    if (!header_valid(hdr, bank_max)) {
+        return false;
+    }
+    if (!fl->read(e->flash_ctx, 0, head, sizeof(head))) {
+        return false;
+    }
+    return SF2L_SignatureOk(head, hdr->bank_size);
+}
+
+/* ------------------------------ источник ----------------------------------- */
+
+static bool read_exact(const SF2L_Env *e, void *dst, uint32_t len)
+{
+    uint8_t *p = (uint8_t *)dst;
+
+    while (len) {
+        uint32_t got = 0;
+        if (!e->src->read(e->src_ctx, p, len, &got) || got == 0 || got > len) {
+            return false;
+        }
+        p += got;
+        len -= got;
+    }
+    return true;
+}
+
+static SF2L_FileStatus inspect_source(const SF2L_Env *e, uint32_t bank_max, uint32_t *size, uint32_t *stamp,
+                                      bool *opened)
+{
+    *opened = false;
+    const SF2SrcStatus st = e->src->open(e->src_ctx, size, stamp);
+
+    if (st == SF2SRC_NO_MEDIA) return SF2L_FILE_NO_MEDIA;
+    if (st == SF2SRC_NO_FILE)  return SF2L_FILE_NO_FILE;
+    if (st != SF2SRC_OK)       return SF2L_FILE_READ_ERROR;
+    *opened = true;
+
+    if (*size < SF2L_BANK_MIN_SIZE) return SF2L_FILE_TOO_SMALL;
+    if (*size > bank_max)           return SF2L_FILE_TOO_LARGE;
+
+    uint8_t head[12];
+    if (!read_exact(e, head, sizeof(head))) return SF2L_FILE_READ_ERROR;
+    if (!SF2L_SignatureOk(head, *size))     return SF2L_FILE_BAD_SIGNATURE;
+    if (!e->src->rewind(e->src_ctx))        return SF2L_FILE_READ_ERROR;
+    return SF2L_FILE_NEW;   /* кандидат; SAME определяется позже */
+}
+
+static bool file_crc(const SF2L_Env *e, uint32_t size, uint32_t *crc_out)
+{
+    uint32_t crc = 0, done = 0;
+
+    if (!e->src->rewind(e->src_ctx)) return false;
+    while (done < size) {
+        const uint32_t n = (size - done < e->buf_size) ? (size - done) : e->buf_size;
+        if (!read_exact(e, e->buf, n)) return false;
+        crc = PM_Crc32_Update(crc, e->buf, n);
+        done += n;
+        PROGRESS(e, SF2L_PHASE_CHECK, done, size);
+    }
+    *crc_out = crc;
+    return true;
+}
+
+/* ------------------------------- запись ------------------------------------ */
+
+static bool erase_bank_area(const SF2L_Env *e, uint32_t size)
+{
+    const SF2FlashOps *fl = e->flash;
+    const uint32_t total = (size + SF2L_SECTOR_SIZE - 1u) & ~(SF2L_SECTOR_SIZE - 1u);
+    uint32_t addr = 0;
+
+    while (addr < total) {
+        /* 64 КБ блок - только если он целиком внутри области банка (никогда не заденет заголовок). */
+        if ((addr % SF2L_BLOCK64_SIZE) == 0u && addr + SF2L_BLOCK64_SIZE <= total) {
+            if (!fl->erase_block64(e->flash_ctx, addr)) return false;
+            addr += SF2L_BLOCK64_SIZE;
+        } else {
+            if (!fl->erase_sector(e->flash_ctx, addr)) return false;
+            addr += SF2L_SECTOR_SIZE;
+        }
+        PROGRESS(e, SF2L_PHASE_ERASE, addr < total ? addr : total, total);
+    }
+    return true;
+}
+
+static bool program_bank(const SF2L_Env *e, uint32_t size)
+{
+    const SF2FlashOps *fl = e->flash;
+    uint32_t addr = 0;
+
+    if (!e->src->rewind(e->src_ctx)) return false;
+    while (addr < size) {
+        const uint32_t n = (size - addr < e->buf_size) ? (size - addr) : e->buf_size;
+        if (!read_exact(e, e->buf, n)) return false;
+        for (uint32_t off = 0; off < n; off += SF2L_PAGE_SIZE) {
+            const uint32_t len = (n - off < SF2L_PAGE_SIZE) ? (n - off) : SF2L_PAGE_SIZE;
+            if (!fl->program_page(e->flash_ctx, addr + off, e->buf + off, len)) return false;
+        }
+        addr += n;
+        PROGRESS(e, SF2L_PHASE_WRITE, addr, size);
+    }
+    return true;
+}
+
+static SF2L_Result flash_update(const SF2L_Env *e, uint32_t size, uint32_t crc, uint32_t stamp)
+{
+    const SF2FlashOps *fl = e->flash;
+    const uint32_t hdr_addr = fl->flash_size - SF2L_SECTOR_SIZE;
+    uint8_t page[SF2L_PAGE_SIZE];
+    SF2L_Header hdr;
+
+    /* 1. Сначала делаем банк невалидным: сбой дальше -> заголовка нет -> повтор на следующем старте. */
+    if (!fl->erase_sector(e->flash_ctx, hdr_addr)) return SF2L_ERR_WRITE;
+    if (!erase_bank_area(e, size))                 return SF2L_ERR_WRITE;
+    if (!program_bank(e, size))                    return SF2L_ERR_WRITE;
+
+    /* 2. Проверка тем же путём, которым потом читает синтезатор (XIP + CRC32 всего банка). */
+    const uint8_t *base = NULL;
+    if (!fl->map(e->flash_ctx, &base) || base == NULL) return SF2L_ERR_FLASH;
+    PROGRESS(e, SF2L_PHASE_VERIFY, 0, size);
+    const uint32_t xip_crc = PM_Crc32_Update(0, base, size);
+    PROGRESS(e, SF2L_PHASE_VERIFY, size, size);
+    fl->unmap(e->flash_ctx);
+    if (xip_crc != crc) return SF2L_ERR_VERIFY;
+
+    /* 3. Коммит: заголовок записывается последним. */
+    header_build(&hdr, size, crc, stamp);
+    memset(page, 0xFF, sizeof(page));
+    memcpy(page, &hdr, sizeof(hdr));
+    if (!fl->program_page(e->flash_ctx, hdr_addr, page, SF2L_PAGE_SIZE)) return SF2L_ERR_WRITE;
+    return SF2L_OK_UPDATED;
+}
+
+/* -------------------------------- сценарий --------------------------------- */
+
+SF2L_Result SF2L_Run(const SF2L_Env *e, SF2L_Report *rep)
+{
+    SF2L_Report dummy;
+    if (!rep) rep = &dummy;
+    memset(rep, 0, sizeof(*rep));
+    rep->file_status = SF2L_FILE_NOT_CHECKED;
+
+    if (!e || !e->flash || !e->buf || e->buf_size < SF2L_PAGE_SIZE || (e->buf_size % SF2L_PAGE_SIZE) != 0u ||
+        e->flash->flash_size < 4u * SF2L_SECTOR_SIZE) {
+        return rep->result = SF2L_ERR_PARAM;
+    }
+
+    const SF2FlashOps *fl = e->flash;
+    const uint32_t bank_max = fl->flash_size - SF2L_SECTOR_SIZE;
+    SF2L_Header hdr;
+    bool have_bank = flash_bank_valid(e, bank_max, &hdr);
+    SF2L_Result res = SF2L_OK_UNCHANGED;
+
+    if (e->src) {
+        uint32_t fsize = 0, fstamp = 0, fcrc = 0;
+        bool opened = false;
+        rep->file_status = inspect_source(e, bank_max, &fsize, &fstamp, &opened);
+
+        if (rep->file_status == SF2L_FILE_NEW) {
+            bool same = false;
+
+            if (have_bank && hdr.bank_size == fsize) {
+                if (hdr.src_stamp == fstamp) {
+                    same = true;                       /* тот же размер и тот же штамп: CRC не нужен */
+                    fcrc = hdr.bank_crc32;
+                } else if (file_crc(e, fsize, &fcrc)) {
+                    same = (fcrc == hdr.bank_crc32);   /* файл скопирован заново, содержимое то же */
+                } else {
+                    rep->file_status = SF2L_FILE_READ_ERROR;
+                }
+            } else if (!file_crc(e, fsize, &fcrc)) {
+                rep->file_status = SF2L_FILE_READ_ERROR;
+            }
+
+            if (rep->file_status == SF2L_FILE_NEW) {
+                if (same) {
+                    rep->file_status = SF2L_FILE_SAME;
+                } else {
+                    res = flash_update(e, fsize, fcrc, fstamp);
+                    if (res != SF2L_OK_UPDATED) {
+                        if (opened) e->src->close(e->src_ctx);
+                        return rep->result = res;
+                    }
+                }
+            }
+        }
+        if (opened) e->src->close(e->src_ctx);
+    }
+
+    /* Итог: во флеше должен быть валидный банк. Включаем XIP. */
+    have_bank = flash_bank_valid(e, bank_max, &hdr);
+    if (!have_bank) {
+        return rep->result = SF2L_ERR_NO_BANK;
+    }
+    const uint8_t *base = NULL;
+    if (!fl->map(e->flash_ctx, &base) || base == NULL) {
+        return rep->result = SF2L_ERR_FLASH;
+    }
+    rep->base  = base;
+    rep->size  = hdr.bank_size;
+    rep->crc32 = hdr.bank_crc32;
+    return rep->result = (res == SF2L_OK_UPDATED) ? SF2L_OK_UPDATED : SF2L_OK_UNCHANGED;
+}
diff --git a/Platform/qspi_xip/sf2_loader_core.h b/Platform/qspi_xip/sf2_loader_core.h
new file mode 100644
index 0000000..90a6d7e
--- /dev/null
+++ b/Platform/qspi_xip/sf2_loader_core.h
@@ -0,0 +1,128 @@
+/**
+ * @file    sf2_loader_core.h
+ * @brief   Логика обновления SoundFont-банка во внешней QSPI Flash (без привязки к HAL/FatFs).
+ *
+ * Ядро работает через две таблицы операций: SF2FlashOps (флеш) и SF2SourceOps (источник файла,
+ * на прошивке - SD-карта через FatFs). Благодаря этому вся логика проверяется на хосте
+ * (tests/test_sf2_loader_core.cpp) с эмуляцией NOR-флеша, включая сбой питания посреди записи.
+ *
+ * Раскладка флеша (flash_size = 8 МБ):
+ *
+ *   0x000000 ... bank_size-1     банк SF2 как есть (XIP: 0x90000000 + смещение);
+ *   ...      ... 0x7FEFFF        свободно, не стирается;
+ *   0x7FF000 ... 0x7FFFFF        сектор заголовка SF2L_Header (последние 4 КБ).
+ *
+ * Максимальный размер банка = flash_size - 4096 (для 8 МБ: 8 384 512 байт).
+ *
+ * Порядок обновления (защита от потери питания и от лишнего износа):
+ *   1. заголовок валиден и совпадает с файлом (размер + штамп времени) -> флеш не трогаем;
+ *   2. штамп другой -> считаем CRC32 файла; совпал с заголовком -> флеш не трогаем;
+ *   3. иначе: стереть сектор заголовка (банк становится "невалидным"), стереть и записать данные,
+ *      проверить CRC32 через XIP (тем же путём, которым потом читает синтезатор),
+ *      и только потом записать заголовок. Сбой в любой момент -> заголовка нет -> при следующем
+ *      старте запись повторится.
+ */
+#ifndef SF2_LOADER_CORE_H
+#define SF2_LOADER_CORE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SF2L_PAGE_SIZE      256u
+#define SF2L_SECTOR_SIZE    4096u
+#define SF2L_BLOCK64_SIZE   65536u
+#define SF2L_BANK_MIN_SIZE  1024u
+#define SF2L_MAGIC          0x46534D50u   /* "PMSF" (little-endian) */
+#define SF2L_LAYOUT         1u
+
+/** Заголовок банка, лежит в последнем секторе флеша (64 байта, остальное в секторе 0xFF). */
+typedef struct {
+    uint32_t magic;          /* SF2L_MAGIC                                             */
+    uint32_t layout;         /* SF2L_LAYOUT                                            */
+    uint32_t bank_size;      /* размер банка в байтах                                  */
+    uint32_t bank_crc32;     /* CRC32 всего банка                                      */
+    uint32_t src_stamp;      /* штамп источника: (FAT date << 16) | FAT time            */
+    uint32_t reserved[10];   /* 0xFFFFFFFF                                             */
+    uint32_t header_crc32;   /* CRC32 предыдущих 60 байт                               */
+} SF2L_Header;
+
+typedef enum { SF2SRC_OK = 0, SF2SRC_NO_MEDIA, SF2SRC_NO_FILE, SF2SRC_ERROR } SF2SrcStatus;
+
+/** Источник файла (SD-карта). read() - последовательное чтение; rewind() - в начало. */
+typedef struct {
+    SF2SrcStatus (*open)(void *ctx, uint32_t *size, uint32_t *stamp);
+    bool         (*read)(void *ctx, void *dst, uint32_t len, uint32_t *got);
+    bool         (*rewind)(void *ctx);
+    void         (*close)(void *ctx);
+} SF2SourceOps;
+
+/** Операции флеша. Все адреса - смещения от начала флеша (не 0x90000000). */
+typedef struct {
+    uint32_t flash_size;
+    bool (*read)(void *ctx, uint32_t addr, void *dst, uint32_t len);          /* indirect-чтение     */
+    bool (*erase_sector)(void *ctx, uint32_t addr);                           /* 4 КБ                */
+    bool (*erase_block64)(void *ctx, uint32_t addr);                          /* 64 КБ               */
+    bool (*program_page)(void *ctx, uint32_t addr, const void *src, uint32_t len); /* в пределах страницы 256 Б */
+    bool (*map)(void *ctx, const uint8_t **base);                             /* включить XIP        */
+    void (*unmap)(void *ctx);                                                 /* выключить XIP       */
+} SF2FlashOps;
+
+typedef enum { SF2L_PHASE_CHECK = 0, SF2L_PHASE_ERASE, SF2L_PHASE_WRITE, SF2L_PHASE_VERIFY } SF2L_Phase;
+typedef void (*SF2L_ProgressFn)(void *ctx, SF2L_Phase phase, uint32_t done, uint32_t total);
+
+typedef enum {
+    SF2L_OK_UNCHANGED = 0,   /* во флеше актуальный банк (SD нет / файла нет / файл тот же)  */
+    SF2L_OK_UPDATED,         /* банк записан из файла и проверен                              */
+    SF2L_ERR_PARAM,
+    SF2L_ERR_NO_BANK,        /* во флеше нет валидного банка и взять его неоткуда             */
+    SF2L_ERR_WRITE,          /* ошибка стирания/записи (банк во флеше невалиден)              */
+    SF2L_ERR_VERIFY,         /* CRC после записи не совпал (банк во флеше невалиден)          */
+    SF2L_ERR_FLASH           /* не удалось включить XIP                                       */
+} SF2L_Result;
+
+typedef enum {
+    SF2L_FILE_NOT_CHECKED = 0,
+    SF2L_FILE_NO_MEDIA,      /* карты нет                                     */
+    SF2L_FILE_NO_FILE,       /* на карте нет SNDFNT.SF2                       */
+    SF2L_FILE_READ_ERROR,
+    SF2L_FILE_TOO_SMALL,
+    SF2L_FILE_TOO_LARGE,     /* больше flash_size - 4096                      */
+    SF2L_FILE_BAD_SIGNATURE, /* не RIFF/sfbk или размер RIFF больше файла     */
+    SF2L_FILE_SAME,          /* совпадает с банком во флеше                   */
+    SF2L_FILE_NEW            /* новый/изменённый, записан во флеш             */
+} SF2L_FileStatus;
+
+typedef struct {
+    SF2L_Result     result;
+    SF2L_FileStatus file_status;
+    const uint8_t  *base;      /* XIP-указатель на банк (только при OK_*) */
+    uint32_t        size;
+    uint32_t        crc32;
+} SF2L_Report;
+
+typedef struct {
+    const SF2FlashOps  *flash;   void *flash_ctx;
+    const SF2SourceOps *src;     void *src_ctx;     /* src может быть NULL: только XIP */
+    uint8_t            *buf;     uint32_t buf_size; /* буфер обмена, кратен 256, >= 256 */
+    SF2L_ProgressFn     progress; void *progress_ctx;
+} SF2L_Env;
+
+/** Выполняет весь сценарий: проверка -> (запись) -> XIP. */
+SF2L_Result SF2L_Run(const SF2L_Env *env, SF2L_Report *report);
+
+/** Проверка сигнатуры SF2 по первым 12 байтам и размеру файла/банка. */
+bool SF2L_SignatureOk(const uint8_t head12[12], uint32_t total_size);
+
+const char *SF2L_ResultName(SF2L_Result r);
+const char *SF2L_FileStatusName(SF2L_FileStatus s);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SF2_LOADER_CORE_H */
diff --git a/Platform/qspi_xip/xip_mpu.c b/Platform/qspi_xip/xip_mpu.c
new file mode 100644
index 0000000..44782c1
--- /dev/null
+++ b/Platform/qspi_xip/xip_mpu.c
@@ -0,0 +1,68 @@
+/**
+ * @file    xip_mpu.c
+ * @brief   См. xip_mpu.h.
+ */
+#include "xip_mpu.h"
+#include "qspi_flash.h"
+
+#include "stm32h7xx_hal.h"
+
+#define XIP_REGION   MPU_REGION_NUMBER1
+
+static void set_region(uint8_t number, uint32_t base, uint8_t size, uint8_t access, uint8_t tex,
+                       uint8_t cacheable, uint8_t xn, uint8_t enable)
+{
+    MPU_Region_InitTypeDef r = {0};
+
+    r.Enable           = enable;
+    r.Number           = number;
+    r.BaseAddress      = base;
+    r.Size             = size;
+    r.SubRegionDisable = 0x00;
+    r.TypeExtField     = tex;
+    r.AccessPermission = access;
+    r.DisableExec      = xn;
+    r.IsShareable      = MPU_ACCESS_NOT_SHAREABLE;
+    r.IsCacheable      = cacheable;
+    r.IsBufferable     = MPU_ACCESS_NOT_BUFFERABLE;   /* C=1,B=0 -> write-through; C=0,B=0 -> non-cacheable */
+    HAL_MPU_ConfigRegion(&r);
+}
+
+void XipMpu_Config(void)
+{
+    HAL_MPU_Disable();
+
+    /* XIP: read-only, write-through cacheable, не исполняемая; выключена до входа в Memory-Mapped. */
+    set_region(XIP_REGION, QSPIFLASH_XIP_BASE, MPU_REGION_SIZE_8MB, MPU_REGION_PRIV_RO_URO,
+               MPU_TEX_LEVEL0, MPU_ACCESS_CACHEABLE, MPU_INSTRUCTION_ACCESS_DISABLE, MPU_REGION_DISABLE);
+
+    /* RAM с DMA-буферами: Normal non-cacheable (TEX=001, C=0, B=0). Поведение то же, что при выключенном D-cache. */
+    set_region(MPU_REGION_NUMBER2, 0x24000000UL, MPU_REGION_SIZE_512KB, MPU_REGION_FULL_ACCESS,
+               MPU_TEX_LEVEL1, MPU_ACCESS_NOT_CACHEABLE, MPU_INSTRUCTION_ACCESS_ENABLE, MPU_REGION_ENABLE);
+    set_region(MPU_REGION_NUMBER3, 0x30000000UL, MPU_REGION_SIZE_512KB, MPU_REGION_FULL_ACCESS,
+               MPU_TEX_LEVEL1, MPU_ACCESS_NOT_CACHEABLE, MPU_INSTRUCTION_ACCESS_ENABLE, MPU_REGION_ENABLE);
+    set_region(MPU_REGION_NUMBER4, 0x38000000UL, MPU_REGION_SIZE_64KB, MPU_REGION_FULL_ACCESS,
+               MPU_TEX_LEVEL1, MPU_ACCESS_NOT_CACHEABLE, MPU_INSTRUCTION_ACCESS_ENABLE, MPU_REGION_ENABLE);
+
+    HAL_MPU_Enable(MPU_PRIVILEGED_DEFAULT);
+}
+
+void XipMpu_SetXipEnabled(bool enable)
+{
+    __DSB();
+    MPU->RNR = XIP_REGION;
+
+    if (enable) {
+        MPU->RASR |= MPU_RASR_ENABLE_Msk;
+        __DSB();
+        __ISB();
+        /* Строки, оставшиеся от прошлой сессии (флеш мог быть перезаписан), недействительны. */
+        SCB_InvalidateDCache_by_Addr((volatile void *)QSPIFLASH_XIP_BASE, (int32_t)QSPIFLASH_SIZE);
+    } else {
+        SCB_InvalidateDCache_by_Addr((volatile void *)QSPIFLASH_XIP_BASE, (int32_t)QSPIFLASH_SIZE);
+        __DSB();
+        MPU->RASR &= ~MPU_RASR_ENABLE_Msk;
+        __DSB();
+        __ISB();
+    }
+}
diff --git a/Platform/qspi_xip/xip_mpu.h b/Platform/qspi_xip/xip_mpu.h
new file mode 100644
index 0000000..7cb39ed
--- /dev/null
+++ b/Platform/qspi_xip/xip_mpu.h
@@ -0,0 +1,39 @@
+/**
+ * @file    xip_mpu.h
+ * @brief   MPU и D-cache для XIP-чтения SoundFont из QSPI Flash (0x90000000).
+ *
+ * Зачем D-cache. Без него каждое чтение int16 из XIP - отдельная QSPI-транзакция (сотни нс), а TinySoundFont
+ * на каждый отсчёт каждого голоса читает два сэмпла. С D-cache сэмплы подтягиваются строками по 32 байта
+ * (16 отсчётов), и пока голос читает последовательно, на 16 чтений приходится одно обращение к флешу.
+ *
+ * Чтобы включить D-cache безопасно (не ломая DMA и SDMMC IDMA), все SRAM, где лежат DMA-буферы,
+ * объявляются Normal non-cacheable - как и сейчас, пока D-cache выключен. Кэшируется только XIP-окно.
+ *
+ * Регионы MPU (регион 0 из main.c MPU_Config() - "всё недоступно, кроме памяти по умолчанию" - не трогается;
+ * для 0x90000000 он служит защитой от спекулятивных обращений за пределы 8 МБ):
+ *   1: 0x90000000, 8 МБ, RO, cacheable write-through. ВКЛЮЧАЕТСЯ ТОЛЬКО пока QSPI в Memory-Mapped режиме
+ *      (иначе спекулятивное чтение Cortex-M7 в окно без отображения может подвесить шину);
+ *   2: AXI SRAM  0x24000000, 512 КБ  - non-cacheable;
+ *   3: SRAM1-3   0x30000000, 512 КБ  - non-cacheable (физически 288 КБ);
+ *   4: SRAM4     0x38000000,  64 КБ  - non-cacheable.
+ */
+#ifndef XIP_MPU_H
+#define XIP_MPU_H
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Настраивает регионы 1..4 и включает MPU. Вызывать после MPU_Config(), ДО SCB_EnableDCache(). */
+void XipMpu_Config(void);
+
+/** Включает/выключает кэшируемое XIP-окно (вызывается драйвером QSPI при входе/выходе из Memory-Mapped). */
+void XipMpu_SetXipEnabled(bool enable);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* XIP_MPU_H */
diff --git a/docs/QSPI_XIP.md b/docs/QSPI_XIP.md
new file mode 100644
index 0000000..29059e7
--- /dev/null
+++ b/docs/QSPI_XIP.md
@@ -0,0 +1,70 @@
+# SoundFont в QSPI Flash (XIP)
+
+Банк `SNDFNT.SF2` (до **8 384 512 байт** = 8 МБ − 4 КБ) хранится во внешней QSPI Flash и читается синтезатором
+напрямую по адресам `0x90000000...` (Memory-Mapped, XIP). RAM-кэша нет. SD-карта нужна только для обновления банка.
+
+## Что происходит при старте (`SoundFontSynth_InitSF2` -> `SF2Loader_Ensure`)
+
+1. Инициализация QSPI (сброс флеша, JEDEC ID, бит Quad Enable).
+2. Есть SD-карта и `0:/SNDFNT.SF2`? Проверка: `RIFF`/`sfbk`, размер, сравнение с заголовком во флеше
+   (размер + штамп времени файла; если штамп другой - CRC32). Флеш **не трогается**, если банк тот же.
+3. Новый/изменённый файл: стирание заголовка -> стирание данных (64 КБ блоки, хвост 4 КБ секторами) -> запись
+   страницами по 256 Б -> проверка CRC32 всего банка **через XIP** -> запись заголовка (коммит).
+   Потеря питания в любой момент = нет заголовка = запись повторится при следующем старте с картой.
+4. QSPI в Memory-Mapped режиме, открывается кэшируемое MPU-окно, TinySoundFont разбирает метаданные из XIP.
+
+Прогресс виден на дисплее и в UART (`[SF2] ...`). Полная запись 8 МБ занимает порядка 30-60 с.
+Если карты нет, а во флеше валидный банк - старт без задержек. Если банка нет нигде - движок SoundFont пропускается
+(как и раньше при отсутствии файла).
+
+## Настройка CubeMX (PurrMidi.ioc)
+
+**Connectivity -> QUADSPI**
+
+| Параметр | Значение |
+|---|---|
+| Mode | **Bank1 with Quad SPI Lines** |
+| Clock Prescaler | **2** (80 МГц - надёжный старт); после проверки можно **1** (120 МГц, предел W25Q64 - 133 МГц) |
+| FIFO Threshold | 1 |
+| Sample Shifting | **Half Cycle Shift** |
+| Flash Size | **23** (в сгенерированном коде должно получиться `hqspi.Init.FlashSize = 22`, т.е. 8 МБ) |
+| Chip Select High Time | **5 Cycles** |
+| Clock Mode | Low |
+| Flash ID | 1 |
+| Dual Flash | Disabled |
+
+**Пины** (CubeMX назначит сам при выборе режима; проверьте): `PB2` CLK, `PB6` NCS, `PD11` IO0, `PD12` IO1,
+`PE2` IO2, `PD13` IO3. С остальной разводкой проекта (SAI, SDMMC, SPI4, USART3) конфликтов нет.
+GPIO Speed: **Very High**, Pull: No. Прерывание QUADSPI и DMA не нужны.
+
+**Clock Configuration**: источник QUADSPI - HCLK (в `.ioc` уже `QSPIFreq = 240 МГц`).
+
+**Cortex-M7 / MPU / Cache в CubeMX не включать**: MPU-регионы 1-4 и D-cache включает код (`XipMpu_Config()`,
+`SCB_EnableDCache()` в `USER CODE BEGIN Init` в `main.c`). Регион 0 из `MPU_Config()` остаётся как есть.
+
+**Project Manager**: сгенерируйте проект. CubeMX добавит `Core/Src/quadspi.c`, `Core/Inc/quadspi.h`,
+`stm32h7xx_hal_qspi.c/.h`, включит `HAL_QSPI_MODULE_ENABLED`, обновит `cmake/stm32cubemx/CMakeLists.txt`.
+CMake сам увидит `quadspi.h` и переключится на XIP-бэкенд (в логе: `SoundFont backend: QSPI XIP`).
+Принудительно вернуть SD-кэш: `-DPURRMIDI_FORCE_SD_CACHE=ON`.
+
+## Почему D-cache обязателен
+
+Без D-cache каждое чтение `int16_t` из XIP - отдельная QSPI-транзакция (сотни нс), а TinySoundFont читает два
+сэмпла на отсчёт каждого голоса. С D-cache строка 32 байта (16 отсчётов) подтягивается одной транзакцией.
+Чтобы не ломать DMA, все SRAM (AXI, SRAM1-3, SRAM4) помечены Normal non-cacheable, кэшируется только
+окно `0x90000000` (8 МБ, read-only, write-through). Окно включается **только пока QSPI в Memory-Mapped**:
+спекулятивные чтения Cortex-M7 в неотображённое окно могут подвесить шину.
+
+## Ограничения
+
+- Размер банка ≤ 8 384 512 байт. Урезайте банк в Polyphone/Swami. (`tests/SNDFNT.SF2` на 27 МБ - только для хост-тестов.)
+- Микросхема - Winbond W25Q64 (WeAct H743). Для другой флеши проверьте коды команд, QE-бит и dummy-циклы
+  (`QSPIFLASH_READ_DUMMY_CYCLES`).
+- Обновление блокирует главный цикл (как и прежняя загрузка с SD); звук в это время не играет.
+- При сбое записи старый банк уже стёрт (запасного слота нет): нужен повторный старт с картой.
+
+## Тесты (хост)
+
+`test_sf2_loader_core` - логика на эмуляции NOR-флеша (пропуск записи, перезапись, сбой питания, ошибка проверки,
+границы стирания). `test_sf2_xip_host` - реальный TinySoundFont поверх XIP-бэкенда; вывод бит-в-бит совпадает
+с файловым кэшем.
