{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OpenOCD Run (PurrMidi)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/purrmidi.elf",
            "gdbTarget": "127.0.0.1:50000",
            "toolchainPrefix": "arm-none-eabi",
            "preLaunchTask": "OpenOCD Run",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw"
        }
    ]
}