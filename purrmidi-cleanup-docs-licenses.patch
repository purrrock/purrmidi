-    fprintf(stderr, "[SD] HAL_SD_Init=%d wide4b=%d hsd.ErrorCode=0x%08lX link=%d f_mount=%d\n",
-            s_diag.hal_init, s_diag.hal_wide, (unsigned long)s_diag.hal_error,
