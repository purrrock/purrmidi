-/**
- * @brief  This function responsible for reception of data from the device
- *  @param  pdev: Selected device
- * @retval None
- */
-
-static void MIDI_ProcessReception(USBH_HandleTypeDef *phost)
-{
-    MIDI_HandleTypeDef *MIDI_Handle =  phost->pActiveClass->pData;
-    USBH_URBStateTypeDef URB_Status = USBH_URB_IDLE;
-    // uint16_t length;
-
-    switch(MIDI_Handle->data_rx_state)
-    {
-    case MIDI_RECEIVE_DATA:
-    {
-        // 1. Отправляем запрос на чтение в зависимости от типа конечной точки
-        uint16_t rx_length = MIDI_Handle->RxDataLength;
-
-        if (rx_length > MIDI_Handle->InEpSize)
-        {
-            rx_length = MIDI_Handle->InEpSize;
-        }
-
-        if (MIDI_Handle->InEpType == USB_EP_TYPE_INTR)
-        {
-            USBH_InterruptReceiveData(phost,
-                    MIDI_Handle->pRxData,
-                    rx_length,
-                    MIDI_Handle->InPipe);
-        }
-        else
-        {
-            USBH_BulkReceiveData (phost,
-                    MIDI_Handle->pRxData,
-                    rx_length,
-                    MIDI_Handle->InPipe);
-        }
-        MIDI_Handle->data_rx_state = MIDI_RECEIVE_DATA_WAIT;
-        break;
-    }
-
-    case MIDI_RECEIVE_DATA_WAIT:
-        URB_Status = USBH_LL_GetURBState(phost, MIDI_Handle->InPipe);
-
-        if (URB_Status == USBH_URB_DONE)
-        {
-            MIDI_Handle->urb_done_cnt++;
-            MIDI_Handle->LastRxLength = USBH_LL_GetLastXferSize(phost, MIDI_Handle->InPipe);
-			
-	MIDI_Handle->rx_bytes_cnt += MIDI_Handle->LastRxLength;
-    if (MIDI_Handle->LastRxLength >= 4U)
-    {
-        MIDI_Handle->usb_midi_packet_cnt +=
-            MIDI_Handle->LastRxLength / 4U;
-    }
-			
-            USBH_MIDI_ReceiveCallback(phost);
-            MIDI_Handle->data_rx_state = MIDI_RECEIVE_DATA;
-        }
-		else if (URB_Status == USBH_URB_NOTREADY)
-        {
-            MIDI_Handle->urb_notready_cnt++;
-
-            if (MIDI_Handle->InEpType == USB_EP_TYPE_INTR)
-            {
-                /* HAL halts an interrupt channel after NAK and does NOT re-activate it,
-                 * so the transfer has to be submitted again (channel is idle here). */
-                uint16_t rx_length = MIDI_Handle->RxDataLength;
-
-                if (rx_length > MIDI_Handle->InEpSize)
-                {
-                    rx_length = MIDI_Handle->InEpSize;
-                }
-
-                USBH_InterruptReceiveData(phost,
-                        MIDI_Handle->pRxData,
-                        rx_length,
-                        MIDI_Handle->InPipe);
-            }
-            /* BULK: on NAK the HAL (HCD_HC_IN_IRQHandler, CHH/HC_NAK) already re-enables
-             * the channel from the ISR and only reports URB_NOTREADY. Submitting again from
-             * the main loop races with that channel: HCTSIZ/xfer_count/urb_state get
-             * overwritten while a packet is being received (XFRC/CHH pending), the finished
-             * transfer is never reported as URB_DONE and the MIDI packet is lost.
-             * Just keep waiting in MIDI_RECEIVE_DATA_WAIT. */
-            MIDI_Handle->data_rx_state = MIDI_RECEIVE_DATA_WAIT;
-        }
-        else if (URB_Status == USBH_URB_ERROR)
-        {
-            MIDI_Handle->urb_error_cnt++;
-            MIDI_Handle->data_rx_state = MIDI_RECEIVE_DATA;
-        }
-        else if (URB_Status == USBH_URB_STALL)
-        {
-            MIDI_Handle->urb_stall_cnt++;
-            MIDI_Handle->data_rx_state = MIDI_RECEIVE_DATA_STALL;
-        }
-        break;
-
-    case MIDI_RECEIVE_DATA_STALL:
-    {
-        USBH_StatusTypeDef req_status = USBH_ClrFeature(phost, MIDI_Handle->InEp);
-        if (req_status == USBH_OK)
-        {
-            USBH_LL_SetToggle(phost, MIDI_Handle->InPipe, 0U);
-            MIDI_Handle->data_rx_state = MIDI_RECEIVE_DATA;
-        }
-        else if (req_status == USBH_BUSY)
-        {
-            /* Keep MIDI_RECEIVE_DATA_STALL state */
-        }
-        else
-        {
-            MIDI_Handle->stall_to_idle_cnt++;
-            MIDI_Handle->data_rx_state = MIDI_IDLE;
-        }
-        break;
-    }
-
-    default:
-        break;
-    }
-}
