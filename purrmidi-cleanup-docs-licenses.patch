-    FILINFO fno;
-    FRESULT fr;
-    unsigned shown = 0U;
-
-    fr = f_opendir(&dir, s_path);
-    if (fr != FR_OK) {
-        fprintf(stderr, "[SD] f_opendir('%s') failed: FRESULT=%d\n", s_path, (int)fr);
-        return;
